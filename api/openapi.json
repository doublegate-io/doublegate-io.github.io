        ],
        "x-scope": "admin"
      }
    },
    "/keys/{key_id}": {
      "delete": {
        "operationId": "revokeKey",
        "tags": [
          "keys"
        ],
        "summary": "Revoke a key; the next request with it is 401. A journal event.",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "revoked": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "no key, a forged key, an expired or revoked key — indistinguishable on purpose (INV-SEC-8, no oracle)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "a live key without the scope: it already proved it is real, so the reason is given",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
