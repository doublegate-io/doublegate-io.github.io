    { "avoid": "Claims you opened", "pattern": "\\b[Cc]laims you opened\\b", "prefer": "Claims opened in this tab", "why": "§7: the assistant; ADR-0128 d8" },
    { "avoid": "<n> claims you can read", "pattern": "\\bclaims you can read\\b", "prefer": "<n> claims this account can read", "why": "§7: the assistant; ADR-0128 d8" },
    { "avoid": "only you can clear it", "pattern": "\\bonly you can clear\\b", "prefer": "a person clears or rejects it", "why": "§7: dg.why's reasons; ADR-0119 d10" },
    { "avoid": "it waits for your signature", "pattern": "\\bwaits for your signature\\b", "prefer": "it waits for a person's signature", "why": "§7: dg.why's reasons; ADR-0119 d10" },
    { "avoid": "Nothing is waiting for you.", "pattern": "\\bNothing is waiting for you\\b", "prefer": "Nothing is waiting for review.", "why": "§7: dg.why's reasons; ADR-0119 d10" },
    { "avoid": "which is why this reached you", "pattern": "\\bwhich is why this reached you\\b", "prefer": "which is why a person reviews it", "why": "§7: dg.why's reasons; ADR-0119 d10" },
    { "avoid": "you wrote it, you are the only reviewer", "pattern": "\\byou wrote it, you are the only reviewer\\b", "prefer": "its author is the only reviewer", "why": "§7: dg.who_can_sign's words; ADR-0134 d3" },
    { "avoid": "No notifier is set up; tell them yourself.", "pattern": "\\bNo notifier is set up; tell them yourself\\b", "prefer": "No notifier is set up: tell them directly.", "why": "§7: dg.who_can_sign's words; ADR-0134 d8" },
    { "avoid": "Tell them yourself.", "pattern": "\\b[Tt]ell them yourself\\b", "prefer": "Tell them directly.", "why": "§7: dg.who_can_sign's words; ADR-0134 d8" },
    { "avoid": "Can sign: you, in development mode", "pattern": "\\bCan sign: you, in development mode\\b", "prefer": "Can sign: this account, in development mode", "why": "§7: dg.who_can_sign's words; ADR-0135 d2" },
    { "avoid": "development mode: your signature counts on your own rows", "pattern": "\\b(development: your signature counts on your own rows while you are this home's only person|development mode: your signature counts on your own rows)\\b", "prefer": "development mode: this home's one person signs their own claims", "why": "§7: doublegate init's comment and line, scripts/demo/up.sh; ADR-0135 d1" },
    { "avoid": "signs their own rows", "pattern": "\\bsigns their own rows\\b", "prefer": "signs their own claims", "why": "§7: every page's foot, To sign's heading, doublegate init and up.sh; ADR-0135 d1, d4; ADR-0104 d8" },
    { "avoid": "graded row", "pattern": "\\bgraded rows?\\b", "prefer": "graded claim", "why": "§7: the policy warning, dg.who_can_sign; ADR-0134 d2, d3; ADR-0104 d8" }
