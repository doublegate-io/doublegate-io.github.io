{
  "decided_by": "ADR-0137; design/docs/03-components/29-words.md",
  "second_person": "\\b[Yy]ou(r|rs|rself|rselves)?\\b",
  "allow": [],
  "banned": [
    { "word": "an exclamation mark", "pattern": "!(?=[\\s\"'”)]|$)", "why": "§2" },
    { "word": "please", "pattern": "\\b[Pp]lease\\b", "why": "§2; GOV.UK: it implies a choice" },
    { "word": "sorry, oops, unfortunately", "pattern": "\\b([Ss]orry|[Oo]ops|[Uu]nfortunately)\\b", "why": "§2, §5" },
    { "word": "something went wrong", "pattern": "\\b[Ss]omething went wrong\\b", "why": "§5: name what failed" },
    { "word": "just now, in a moment, a while", "pattern": "\\b([Jj]ust now|[Ii]n a moment|a while)\\b", "why": "§6" },
    { "word": "praise", "pattern": "\\b(Great|Awesome|Nice work|Well done|All set)\\b", "why": "§2" },
    { "word": "the first person singular", "pattern": "\\b(I(?![/.-]\\w)|[Mm]e|[Mm]y|[Mm]ine|[Mm]yself)\\b", "why": "§2" },
    { "word": "the first person plural", "pattern": "\\b([Ww]e|[Oo]ur|[Oo]urs)\\b", "except": ["doublegate-site"], "why": "§2: the site keeps we for the company's commitments" }
  ],
  "prefer": [
